{
  "name": "codex-everywhere",
  "version": "0.3.0-alpha.6",
  "description": "A self-hosted Codex Web/PWA control plane for Linux and HPC.",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:public": "node scripts/check-public-repo.mjs",
    "clean": "pnpm -r clean",
    "dev": "pnpm --parallel --filter @codex-everywhere/agent --filter @codex-everywhere/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:app-server": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
