{
  "name": "codex-everywhere",
  "version": "0.4.0-alpha.8",
  "description": "A self-hosted Codex Web/PWA control plane for Linux and HPC.",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:public": "node scripts/check-public-repo.mjs",
    "check:test-runtime": "node scripts/check-test-runtime-capabilities.mjs",
    "check:web-budget": "node scripts/check-web-bundle-budget.mjs",
    "clean": "pnpm -r clean",
    "dev": "pnpm --parallel --filter @codex-everywhere/agent --filter @codex-everywhere/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:codex-notification-schema": "node scripts/generate-codex-notification-schema.mjs",
    "staging:receipt": "node scripts/manage-v0.4-staging-receipt.mjs",
    "test": "vitest run",
    "test:app-server": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "verify:v0.4": "node scripts/run-v0.4-candidate-checks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
